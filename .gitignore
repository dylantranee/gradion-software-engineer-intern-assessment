# Dependencies
node_modules/
.pnpm-store/

# Environment variables & secrets (CRITICAL: Never commit Gemini API keys)
.env
.env.local
.env.*.local

# Local storage and runtime data
data/
server/data/
client/dist/
dist/
build/

# Logs and debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Operating System files
.DS_Store
Thumbs.db

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Claude Code session-local artifacts (not meant for the shared repo)
.claude/settings.local.json
.claude/worktrees/

# Build artifacts from shared/'s own tsconfig.json (composite project, referenced by backend/tsconfig.json)
shared/*.js
shared/*.d.ts
shared/*.tsbuildinfo

# Vitest / Coverage
coverage/
.nyc_output/
