# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Family (text uses the "-latest" alias so it never silently points
# at a retired snapshot; image is the Nano Banana family — see docs/DECISIONS.md)
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Port Configuration
BACKEND_PORT=3001
FRONTEND_PORT=3000
NODE_ENV=development

# Storage Path
STORAGE_DIR=./data
